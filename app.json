{
  "expo": {
    "name": "Brisa",
    "slug": "brisa-clima",
    "scheme": "brisa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#101417",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.guilhermereis.brisa"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#101417",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "com.guilhermereis.brisa"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Brisa · O céu por aqui",
      "themeColor": "#101417"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        { "image": "./assets/splash-icon.png", "imageWidth": 140, "backgroundColor": "#101417" }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permita que o Brisa use sua localização para consultar o clima perto de você.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ]
    ]
  }
}
