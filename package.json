{
  "name": "brisa",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.25",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-location": "~58.0.22",
    "expo-router": "~58.0.31",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "lucide-react-native": "^1.73.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@playwright/test": "^1.65.1",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "demo": "node scripts/record-demo.mjs",
    "export:web": "expo export --platform web",
    "export:native": "expo export --platform android --platform ios",
    "verify": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "private": true
}
